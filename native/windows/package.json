{
  "name": "conta-comigo",
  "productName": "Conta Comigo",
  "version": "2.6.3",
  "description": "Jogo educativo de matemática para crianças a partir de 4 anos — 100% offline, sem coleta de dados",
  "author": "Klivfy Tecnologia",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable appx --publish never"
  },
  "devDependencies": {
    "electron": "^44.9.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.klivfy.conta.comigo.matematica",
    "productName": "Conta Comigo",
    "copyright": "Copyright © 2026 Klivfy Tecnologia",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "app/**/*",
      "build/icon.ico"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "appx",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "conta-comigo-windows-${version}-${arch}-instalador.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Conta Comigo"
    },
    "portable": {
      "artifactName": "conta-comigo-windows-${version}-${arch}-portatil.${ext}"
    },
    "appx": {
      "identityName": "Klivfy.ContaComigo",
      "publisher": "CN=00000000-0000-0000-0000-000000000000",
      "publisherDisplayName": "Klivfy Tecnologia",
      "applicationId": "ContaComigo",
      "displayName": "Conta Comigo",
      "languages": [
        "pt-BR",
        "en-US",
        "es-ES"
      ],
      "artifactName": "conta-comigo-windows-${version}-${arch}-loja.${ext}"
    }
  }
}
