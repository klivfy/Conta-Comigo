{
  "manifest_version": 3,
  "name": "Conta Comigo — Matemática para Crianças",
  "version": "2.4.1",
  "description": "12 modos de matemática lúdica para crianças de 4 anos+: contagem, contas, histórias, dinheiro, duelos, chefe e loja. Clique no ícone e o jogo abre sempre em tela cheia.",
  "author": "Conta Comigo",
  "action": {
    "default_title": "Abrir o Conta Comigo em tela cheia",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "commands": {
    "abrir-conta-comigo": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Abrir o Conta Comigo em tela cheia"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "conta-comigo@kidmath.app",
      "strict_min_version": "109.0"
    }
  }
}
